{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/auth/config",
      "destination": "https://app.acetate.me/api/auth/config"
    },
    {
      "source": "/api/auth/authorize",
      "destination": "https://app.acetate.me/api/auth/authorize"
    },
    {
      "source": "/api/request-access",
      "destination": "https://app.acetate.me/api/request-access"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms-of-service.html",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/#sign-in",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
